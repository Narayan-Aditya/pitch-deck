# Copy to .env.local for local development. On Vercel, set these under
# Project Settings -> Environment Variables instead — .env.local is gitignored
# and never reaches the deploy.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Writes the brand summary, the Instagram insight, the audience-fit paragraph,
# and picks which of the creator's videos go on the match slide. Without it
# every "auto-fills by itself" step on the report page fails and has to be
# typed in by hand. https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Supabase: Google sign-in, report storage, and the usage counters.
# Supabase dashboard -> Project Settings -> API.
#
# The URL is the API endpoint (https://<ref>.supabase.co), NOT the
# https://supabase.com/dashboard/project/<ref> address you browse to. Those are
# different hosts, and the dashboard one answers every query with HTML.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public by design and safe in the browser bundle: it carries no privileges of
# its own, and row level security decides what each signed-in user may read.
# The service_role key is a different thing entirely — it bypasses RLS, so it
# must never appear here or anywhere else client-side.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Instagram session cookie. This is what fetches a prospect's follower and
# engagement numbers — automatically the first time a report is opened, and
# again whenever "↻ Get latest" is pressed.
#
# SET THIS ON VERCEL TOO. It used to be local-only, back when the scraper was
# ig_data.py and serverless had no Python to run it. lib/instagramScrape.js
# replaced that with plain HTTP, so the lookup works deployed — but only if this
# is set. Without it every report opens with zeros and the numbers have to be
# typed in by hand, with no error beyond a note on the card.
#
# Expires every few days; re-copy it from a logged-in browser session.
#
# ToS note: this drives automated requests against a real logged-in session —
# there is genuine checkpoint/ban risk on that account. Use a secondary one.
IG_SESSIONID=

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------

# Model behind all four generation steps. Defaults to gpt-4.1-mini.
# OPENAI_RESEARCH_MODEL=gpt-4.1-mini
